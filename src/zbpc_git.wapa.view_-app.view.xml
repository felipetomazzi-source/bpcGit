<mvc:View controllerName="bpc.git.controller.App"                                                                                                                                                                                                              
  xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                  
  xmlns:core="sap.ui.core"                                                                                                                                                                                                                                     
  xmlns:f="sap.ui.layout.form"                                                                                                                                                                                                                                 
  xmlns="sap.m">                                                                                                                                                                                                                                               
  <App id="app">                                                                                                                                                                                                                                               
    <Page id="page" title="bpcGit - Version control for BPC">                                                                                                                                                                                                  
      <content>                                                                                                                                                                                                                                                
        <MessageStrip                                                                                                                                                                                                                                          
          text="{app>/setupError}"                                                                                                                                                                                                                             
          type="Error"                                                                                                                                                                                                                                         
          showIcon="true"                                                                                                                                                                                                                                      
          visible="{= !!${app>/setupError} }"                                                                                                                                                                                                                  
          class="sapUiSmallMargin"/>                                                                                                                                                                                                                           
        <f:SimpleForm id="setupForm"                                                                                                                                                                                                                           
          title="Repository setup"                                                                                                                                                                                                                             
          editable="true"                                                                                                                                                                                                                                      
          layout="ResponsiveGridLayout"                                                                                                                                                                                                                        
          labelSpanL="3"                                                                                                                                                                                                                                       
          labelSpanM="3"                                                                                                                                                                                                                                       
          busy="{app>/setupBusy}">                                                                                                                                                                                                                             
          <f:content>                                                                                                                                                                                                                                          
            <Label text="BPC environment" required="true"/>                                                                                                                                                                                                    
            <Select id="environmentSelect"                                                                                                                                                                                                                     
              selectedKey="{app>/environment}"                                                                                                                                                                                                                 
              items="{app>/environments}"                                                                                                                                                                                                                      
              change=".onEnvironmentChange">                                                                                                                                                                                                                   
              <core:Item key="{app>id}" text="{app>id}"/>                                                                                                                                                                                                      
            </Select>                                                                                                                                                                                                                                          
            <Label text="Repository URL" required="true"/>                                                                                                                                                                                                     
            <Input id="urlInput"                                                                                                                                                                                                                               
              value="{app>/config/url}"                                                                                                                                                                                                                        
              type="Url"                                                                                                                                                                                                                                       
              maxLength="255"                                                                                                                                                                                                                                  
              placeholder="https://github.com/owner/repository.git"/>                                                                                                                                                                                          
            <Label text="Branch"/>                                                                                                                                                                                                                             
            <Input id="branchInput"                                                                                                                                                                                                                            
              value="{app>/config/branch}"                                                                                                                                                                                                                     
              maxLength="255"                                                                                                                                                                                                                                  
              placeholder="main"/>                                                                                                                                                                                                                             
            <Label text="Status"/>                                                                                                                                                                                                                             
            <ObjectStatus                                                                                                                                                                                                                                      
              text="{app>/changedText}"                                                                                                                                                                                                                        
              state="{= ${app>/configured} ? 'Success' : 'Warning' }"/>                                                                                                                                                                                        
            <Label text=""/>                                                                                                                                                                                                                                   
            <Button text="Save" type="Emphasized" press=".onSave"                                                                                                                                                                                              
              enabled="{= !${app>/setupBusy} &amp;&amp; !!${app>/environment} }"/>                                                                                                                                                                             
          </f:content>                                                                                                                                                                                                                                         
        </f:SimpleForm>                                                                                                                                                                                                                                        
        <f:SimpleForm id="connectionForm"                                                                                                                                                                                                                      
          title="Connection"                                                                                                                                                                                                                                   
          editable="false"                                                                                                                                                                                                                                     
          layout="ResponsiveGridLayout"                                                                                                                                                                                                                        
          labelSpanL="3"                                                                                                                                                                                                                                       
          labelSpanM="3"                                                                                                                                                                                                                                       
          busy="{app>/connectionBusy}"                                                                                                                                                                                                                         
          visible="{app>/configured}">                                                                                                                                                                                                                         
          <f:content>                                                                                                                                                                                                                                          
            <Label text="Git login"/>                                                                                                                                                                                                                          
            <Text text="{= ${app>/gitUser} ? ${app>/gitUser} + ' (this page only, until you reload it)' : 'Not logged in. You are asked when the Git host needs it.' }"/>                                                                                      
            <Label text="Read access"/>                                                                                                                                                                                                                        
            <ObjectStatus                                                                                                                                                                                                                                      
              text="{= ${app>/connectionError} ? ${app>/connectionError} : (${app>/connection} ? 'OK. Branches: ' + (${app>/connection/branchesText} || 'none, the repository is empty') : 'Not tested') }"                                                    
              state="{= ${app>/connectionError} ? 'Error' : (${app>/connection} ? 'Success' : 'None') }"/>                                                                                                                                                     
            <Label text="Branch"/>                                                                                                                                                                                                                             
            <ObjectStatus                                                                                                                                                                                                                                      
              text="{= !${app>/connection} ? '' : (${app>/connection/branchFound} ? ${app>/connection/branch} + ' exists' : ${app>/connection/branch} + ' does not exist yet. The first commit creates it.') }"                                                
              state="{= !${app>/connection} ? 'None' : (${app>/connection/branchFound} ? 'Success' : 'Warning') }"/>                                                                                                                                           
            <Label text="Push access"/>                                                                                                                                                                                                                        
            <ObjectStatus                                                                                                                                                                                                                                      
              text="{= !${app>/connection} ? '' : (!${app>/connection/pushChecked} ? 'Not checked. Log in to check it.' : (${app>/connection/pushOk} ? 'OK' : 'Refused: ' + ${app>/connection/pushMessage})) }"                                                
              state="{= !${app>/connection} ? 'None' : (!${app>/connection/pushChecked} ? 'Warning' : (${app>/connection/pushOk} ? 'Success' : 'Error')) }"/>                                                                                                  
            <Label text=""/>                                                                                                                                                                                                                                   
            <HBox>                                                                                                                                                                                                                                             
              <Button text="Test connection" type="Emphasized" press=".onTestConnection"                                                                                                                                                                       
                enabled="{= !${app>/connectionBusy} }" class="sapUiSmallMarginEnd"/>                                                                                                                                                                           
              <Button text="Log in and check push access" press=".onLogin"                                                                                                                                                                                     
                visible="{= !${app>/gitUser} }" enabled="{= !${app>/connectionBusy} }" class="sapUiSmallMarginEnd"/>                                                                                                                                           
              <Button text="Log out" press=".onLogout" visible="{= !!${app>/gitUser} }"/>                                                                                                                                                                      
            </HBox>                                                                                                                                                                                                                                            
          </f:content>                                                                                                                                                                                                                                         
        </f:SimpleForm>                                                                                                                                                                                                                                        
        <Panel headerText="Installation check" expandable="true" expanded="false">                                                                                                                                                                             
          <f:SimpleForm id="infoForm"                                                                                                                                                                                                                          
            editable="false"                                                                                                                                                                                                                                   
            layout="ResponsiveGridLayout">                                                                                                                                                                                                                     
            <f:content>                                                                                                                                                                                                                                        
              <Label text="App version"/>                                                                                                                                                                                                                      
              <Text text="{app>/appVersion}"/>                                                                                                                                                                                                                 
              <Label text="UI5 version"/>                                                                                                                                                                                                                      
              <Text text="{app>/ui5Version}"/>                                                                                                                                                                                                                 
              <Label text="Theme"/>                                                                                                                                                                                                                            
              <Text text="{app>/theme}"/>                                                                                                                                                                                                                      
              <Label text="Loaded at"/>                                                                                                                                                                                                                        
              <Text text="{app>/loadedAt}"/>                                                                                                                                                                                                                   
              <Label text="bpcGit API"/>                                                                                                                                                                                                                       
              <ObjectStatus                                                                                                                                                                                                                                    
                text="{= ${app>/pingBusy} ? 'Checking...' : (${app>/pingError} ? 'Error: ' + ${app>/pingError} : 'Connected') }"                                                                                                                               
                state="{= ${app>/pingBusy} ? 'None' : (${app>/pingError} ? 'Error' : 'Success') }"/>                                                                                                                                                           
              <Label text="SAP user"/>                                                                                                                                                                                                                         
              <Text text="{app>/ping/user}"/>                                                                                                                                                                                                                  
              <Label text="System / client"/>                                                                                                                                                                                                                  
              <Text text="{= ${app>/ping} ? ${app>/ping/system} + ' / ' + ${app>/ping/client} : '' }"/>                                                                                                                                                        
              <Label text="abapGit"/>                                                                                                                                                                                                                          
              <ObjectStatus                                                                                                                                                                                                                                    
                text="{= !${app>/ping} ? '' : (${app>/ping/abapGit/installed} ? 'Developer version ' + ${app>/ping/abapGit/version} : 'Not installed: bpcGit needs the abapGit developer version') }"                                                          
                state="{= !${app>/ping} ? 'None' : (${app>/ping/abapGit/installed} ? 'Success' : 'Error') }"/>                                                                                                                                                 
              <Label text=""/>                                                                                                                                                                                                                                 
              <Button text="Check again" press=".onPing" enabled="{= !${app>/pingBusy} }"/>                                                                                                                                                                    
            </f:content>                                                                                                                                                                                                                                       
          </f:SimpleForm>                                                                                                                                                                                                                                      
        </Panel>                                                                                                                                                                                                                                               
      </content>                                                                                                                                                                                                                                               
    </Page>                                                                                                                                                                                                                                                    
  </App>                                                                                                                                                                                                                                                       
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               