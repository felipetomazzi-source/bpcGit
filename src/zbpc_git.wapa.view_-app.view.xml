<mvc:View controllerName="bpc.git.controller.App"                                                                                                                                                                                                              
  xmlns:mvc="sap.ui.core.mvc"                                                                                                                                                                                                                                  
  xmlns:f="sap.ui.layout.form"                                                                                                                                                                                                                                 
  xmlns="sap.m">                                                                                                                                                                                                                                               
  <App id="app">                                                                                                                                                                                                                                               
    <Page id="page" title="bpcGit - Version control for BPC">                                                                                                                                                                                                  
      <content>                                                                                                                                                                                                                                                
        <MessageStrip                                                                                                                                                                                                                                          
          text="bpcGit is installed. Build step 1: BSP application shell."                                                                                                                                                                                     
          type="Success"                                                                                                                                                                                                                                       
          showIcon="true"                                                                                                                                                                                                                                      
          class="sapUiSmallMargin"/>                                                                                                                                                                                                                           
        <f:SimpleForm id="infoForm"                                                                                                                                                                                                                            
          title="Installation check"                                                                                                                                                                                                                           
          editable="false"                                                                                                                                                                                                                                     
          layout="ResponsiveGridLayout">                                                                                                                                                                                                                       
          <f:content>                                                                                                                                                                                                                                          
            <Label text="App version"/>                                                                                                                                                                                                                        
            <Text text="{app>/appVersion}"/>                                                                                                                                                                                                                   
            <Label text="UI5 version"/>                                                                                                                                                                                                                        
            <Text text="{app>/ui5Version}"/>                                                                                                                                                                                                                   
            <Label text="Theme"/>                                                                                                                                                                                                                              
            <Text text="{app>/theme}"/>                                                                                                                                                                                                                        
            <Label text="Loaded at"/>                                                                                                                                                                                                                          
            <Text text="{app>/loadedAt}"/>                                                                                                                                                                                                                     
          </f:content>                                                                                                                                                                                                                                         
        </f:SimpleForm>                                                                                                                                                                                                                                        
        <MessageStrip                                                                                                                                                                                                                                          
          text="Next: repository setup (Git URL, branch, SM59 destination) and environment selection."                                                                                                                                                         
          type="Information"                                                                                                                                                                                                                                   
          showIcon="true"                                                                                                                                                                                                                                      
          class="sapUiSmallMargin"/>                                                                                                                                                                                                                           
      </content>                                                                                                                                                                                                                                               
    </Page>                                                                                                                                                                                                                                                    
  </App>                                                                                                                                                                                                                                                       
</mvc:View>                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               